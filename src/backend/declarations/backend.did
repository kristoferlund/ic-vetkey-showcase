type EncryptedNote = record {
  updated_at : nat64;
  owner : principal;
  data : blob;
  created_at : nat64;
};
type Result = variant { Ok : blob; Err : text };
type Result_1 = variant { Ok : bool; Err : text };
type Result_2 = variant { Ok : EncryptedNote; Err : text };
type Result_3 = variant { Ok : TimeLock; Err : text };
type TimeLock = record { data : blob; locked : bool; timelock_id : nat64 };
service : {
  get_root_public_key : () -> (Result);
  get_user_key : (blob, text) -> (Result);
  notes_delete : () -> (Result_1);
  notes_get : () -> (Result_2) query;
  notes_has : () -> (Result_1) query;
  notes_save : (blob) -> (Result_2);
  timelock_create : (nat64, blob) -> (Result_3);
  timelock_list : () -> (vec TimeLock) query;
  timelock_open : (nat64) -> (Result_3);
}
